# ── Telegram: аккаунт-сборщик (read-only, отдельный номер) ──────────────
TG_API_ID=
TG_API_HASH=
TG_PHONE=
TG_SESSION_PATH=data/lid_ai.session

# ── Telegram: бот для группы ЛИДЫ ───────────────────────────────────────
BOT_TOKEN=
# Группа «ЛИДЫ» (для супергруппы id вида -1001234567890)
LEADS_GROUP_ID=
# Если группа без топиков — оставить пустым; тогда профили различаются тегом
LEADS_DEFAULT_TOPIC_ID=

# ── LLM ─────────────────────────────────────────────────────────────────
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
# Предохранитель: дневной лимит расходов, USD
LLM_DAILY_BUDGET_USD=2.0
LLM_CONCURRENCY=4

# ── База ────────────────────────────────────────────────────────────────
DB_PATH=data/lid_ai.db

# ── Режим ───────────────────────────────────────────────────────────────
# dry_run = считать и писать в БД, но НЕ отправлять в Telegram
DRY_RUN=true
LOG_LEVEL=INFO
